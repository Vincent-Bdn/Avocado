{
  "name": "avocado",
  "version": "0.1.0",
  "private": true,
  "description": "Suivi de dossiers pour avocats",
  "license": "AGPL-3.0-only",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "electron:dev": "vite build && electron .",
    "electron:pack": "vite build && electron-builder --dir",
    "icons": "powershell -ExecutionPolicy Bypass -File scripts/make-icons.ps1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "fr.avocado.app",
    "productName": "Avocado",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "../artifacts/backend",
        "to": "backend"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "mac": {
      "icon": "public/icon.png",
      "category": "public.app-category.business"
    },
    "linux": {
      "icon": "public/icon.png",
      "target": "AppImage",
      "category": "Office"
    }
  }
}
