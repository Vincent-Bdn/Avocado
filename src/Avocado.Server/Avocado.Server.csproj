<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>avocado-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Sqlite.Core, NOT Sqlite. The full package drags in SQLitePCLRaw.bundle_e_sqlite3, plain SQLite,
      the exact bundle the vault must never be linked against. Two bundles in one process means
      whichever registers first wins, and if that is e_sqlite3 then `PRAGMA key` is a no-op and the
      whole practice is written in plaintext with no error. Avocado.Vault brings
      bundle_e_sqlcipher and stays the single provider; VaultDatabase asserts
      `PRAGMA cipher_version` at every open so a regression here fails loudly instead of silently.
    -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="MsgReader" Version="6.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avocado.Vault\Avocado.Vault.csproj" />
  </ItemGroup>

</Project>
