<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>avocado-server</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Sqlite.Core, NOT Sqlite. The full package drags in SQLitePCLRaw.bundle_e_sqlite3, plain SQLite,
      the exact bundle the vault must never be linked against. Two bundles in one process means
      whichever registers first wins, and if that is e_sqlite3 then `PRAGMA key` is a no-op and the
      whole practice is written in plaintext with no error. Avocado.Vault brings
      bundle_e_sqlcipher and stays the single provider; VaultDatabase asserts
      `PRAGMA cipher_version` at every open so a regression here fails loudly instead of silently.
    -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <PackageReference Include="MsgReader" Version="6.1.0" />
    <PackageReference Include="PdfPig" Version="0.1.11" />
    <PackageReference Include="PDFsharp" Version="6.2.1" />

    <!--
      Transitive, through MimeKit, and pinned here only to raise the version NuGet resolves.

      MimeKit asks for System.Security.Cryptography.Pkcs >= 10.0.9 and NuGet takes the floor, so it
      landed on 10.0.9 — which CVE-2026-70162 and CVE-2026-84008 cover, along with everything up to
      10.0.12 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx; both denial of service, fixed in 10.0.13).
      `TreatWarningsAsErrors` turns NuGet's audit warning into a restore failure, which is the
      arrangement we want: the build broke on the day the advisory was published, on code nobody had
      touched.

      A direct reference is the whole fix: bumping MimeKit would only move the floor, and its next
      release may well still ask for a version inside the vulnerable range. Delete this line once
      MimeKit's own floor is 10.0.13 or higher; `dotnet list package` with the transitive flag says
      which version is actually resolved.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests draw PDFs to read back, and drawing needs the font resolver, which is internal
         and should stay that way: it is not part of what this assembly offers. -->
    <InternalsVisibleTo Include="Avocado.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Drawn onto a stamped pièce. PDFsharp carries no font of its own and throws
      "No appropriate font found" for every family name, Helvetica included, unless a resolver is
      registered: that failed on Windows exactly as readily as on Linux. IBM Plex Sans is the
      interface's own typeface, is under the SIL Open Font License, and travels inside the binary so
      that a pièce stamped on a Mac and one stamped on a PC carry the same glyphs. The licence sits
      beside the file, as the OFL requires. See StampFont.
    -->
    <EmbeddedResource Include="Resources\IBMPlexSans.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Avocado.Vault\Avocado.Vault.csproj" />
  </ItemGroup>

</Project>
